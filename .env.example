# Runtime environment. Copy to `.env` to override; all values have defaults.

# development | test | production
NODE_ENV=development

# HTTP server
PORT=3000
HOST=127.0.0.1

# SQLite database file, or `:memory:` (tests only)
DATABASE_PATH=./data/tasks.db

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
