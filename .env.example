# Runtime environment. Copy to `.env` to override; all values have defaults.

# development | test | production
NODE_ENV=development

# HTTP server
PORT=3000
HOST=127.0.0.1

# PostgreSQL connection used by the API.
# Start the bundled database with `npm run db:up`.
DATABASE_URL=postgres://task:task@127.0.0.1:5433/task_management
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Test database. Tests create and drop an isolated schema for each test.
TEST_DATABASE_URL=postgres://task:task@127.0.0.1:5433/task_management_test

# pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
