# Base URL for the task API. The default uses the Vite proxy, which keeps the
# dashboard same-origin and avoids the API's intentional lack of CORS support.
VITE_API_BASE_URL=/api/v1

# Optional absolute health URL. Derived from VITE_API_BASE_URL when omitted.
# VITE_HEALTH_URL=http://127.0.0.1:3000/healthz
